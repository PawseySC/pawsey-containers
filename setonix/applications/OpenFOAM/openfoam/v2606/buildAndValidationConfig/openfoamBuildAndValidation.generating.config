# Experimental standalone tutorial generator recipe. This file deliberately
# contains only data needed by the v2606/OpenFOAM/Singularity prototype.
OPENFOAM_FORK="openfoam"
OPENFOAM_VERSION="v2606"
TUTORIAL_CASE_NAME="periodicPlaneChannel"
TUTORIAL_CASE_SEARCH_NAME="periodicPlaneChannel"
TUTORIAL_NPROCS=4
TUTORIAL_IO_GROUP_SIZE=2
TUTORIAL_DECOMPOSITION="(1 2 2)"
TUTORIAL_SOLVER="pimpleFoam"
TUTORIAL_END_TIME=100
TUTORIAL_WRITE_INTERVAL=20
TUTORIAL_MAX_EXECUTION_TIME=50
TUTORIAL_MAX_UX_INITIAL_RESIDUAL=0.012
TUTORIAL_PRE_NODES=1
TUTORIAL_PRE_TASKS=1
TUTORIAL_PRE_CPUS_PER_TASK=1
TUTORIAL_PRE_MEMORY=14GB
TUTORIAL_PRE_TIME=00:10:00
TUTORIAL_RUN_NODES=2
TUTORIAL_RUN_TASKS=4
TUTORIAL_RUN_TASKS_PER_NODE=2
TUTORIAL_RUN_CPUS_PER_TASK=1
TUTORIAL_RUN_TIME=00:10:00

# Ordered tool invocations are emitted as explicit commands, not interpreted in jobs.
TUTORIAL_EXTRACT_STEPS=(locate_unique copy validate)
TUTORIAL_PRE_STEPS=(blockMesh renumberMesh checkMesh decomposePar)
TUTORIAL_PRE_blockMesh=(blockMesh)
TUTORIAL_PRE_renumberMesh=(renumberMesh -overwrite -constant)
TUTORIAL_PRE_checkMesh=(checkMesh -allTopology -allGeometry -constant)
TUTORIAL_PRE_decomposePar=(decomposePar -cellDist -force)
TUTORIAL_RUN_STEPS=(parallel_pimpleFoam)
