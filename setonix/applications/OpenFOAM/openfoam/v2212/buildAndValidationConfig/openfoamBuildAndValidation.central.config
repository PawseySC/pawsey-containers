# Version-specific settings used by the general OpenFOAM build and validation scripts

# ---
# Expected OpenFoam fork and version
OPENFOAM_FORK="openfoam"
OPENFOAM_VERSION="v2212"

# ---
# Internal image-log validation settings.
# Variables used in scripts: buildingScripts/openfoamContainerBuild.sh & basic/openfoamImageValidation.sh
#
# Use a single-quoted path when the value contains OpenFOAM environment
# variables. This prevents host-side expansion when this configuration is
# sourced and preserves the variable for expansion inside the image.
#
# Set a variable to "NO_CHECK" when its validation step should be skipped.
THIRDPARTY_BUILD_LOG='$WM_THIRD_PARTY_DIR/log.Allwmake.AuthoritativeSummary'
PARAVIEW_BUILD_LOG='$WM_THIRD_PARTY_DIR/log.makePV.AuthoritativeSummary'
OPENFOAM_BUILD_LOG='$WM_PROJECT_DIR/log.Allwmake.AuthoritativeSummary'
OPENFOAM_TOOL_LOG='$WM_PROJECT_DIR/log.OF_TOOL'
#OPENFOAM_TOOL_LOG="NO_CHECK" #Example of use of NO_CHECK if required

# ---
# Variables used in scripts: basic/openfoamBasicTests.sh
DEFAULT_TOOL="icoFoam"

#---
# Variables used in scripts: setonix/compileMyTool/openfoamCompileTests.sh
COMPILE_TEMPLATE_TOOL="icoFoam"
COMPILED_TEST_TOOL="myIcoFoam"

# Central tutorial workflow: ordered data only; operations live in the shared library.
TUTORIAL_CASE_NAME="periodicPlaneChannel"
TUTORIAL_NPROCS=4
TUTORIAL_IO_GROUP_SIZE=2
TUTORIAL_PRE_NODES=1
TUTORIAL_PRE_TASKS=1
TUTORIAL_PRE_CPUS_PER_TASK=1
TUTORIAL_PRE_MEMORY=14GB
TUTORIAL_PRE_TIME=00:10:00
TUTORIAL_RUN_NODES=2
TUTORIAL_RUN_TASKS=4
TUTORIAL_RUN_CPUS_PER_TASK=1
TUTORIAL_RUN_TIME=00:10:00

TUTORIAL_EXTRACT_STEPS=(copy system constant initial control decomposition)
TUTORIAL_EXTRACT_copy=(extract_unique)
TUTORIAL_EXTRACT_system=(require_directory system)
TUTORIAL_EXTRACT_constant=(require_directory constant)
TUTORIAL_EXTRACT_initial=(require_initial_conditions)
TUTORIAL_EXTRACT_control=(require_file system/controlDict)
TUTORIAL_EXTRACT_decomposition=(require_file system/decomposeParDict)

TUTORIAL_PRE_STEPS=(
    restore clean end_time write_interval subdomains method coefficients
    mesh renumber mesh_check mesh_ok decompose decomposition_ok
)
TUTORIAL_PRE_restore=(restore_initial_conditions 0.orig 0)
TUTORIAL_PRE_clean=(remove_decomposition)
TUTORIAL_PRE_end_time=(set_dictionary system/controlDict endTime 100)
TUTORIAL_PRE_write_interval=(set_dictionary system/controlDict writeInterval 20)
TUTORIAL_PRE_subdomains=(set_dictionary system/decomposeParDict numberOfSubdomains "$TUTORIAL_NPROCS")
TUTORIAL_PRE_method=(set_dictionary system/decomposeParDict method simple)
TUTORIAL_PRE_coefficients=(set_dictionary system/decomposeParDict coeffs/n "(1 2 2)" vector)
TUTORIAL_PRE_mesh=(run blockMesh blockMesh)
TUTORIAL_PRE_renumber=(run renumberMesh renumberMesh -overwrite -constant)
TUTORIAL_PRE_mesh_check=(run checkMesh checkMesh -allTopology -allGeometry -constant)
TUTORIAL_PRE_mesh_ok=(require_log_text checkMesh "Mesh OK")
TUTORIAL_PRE_decompose=(run decomposePar decomposePar -cellDist -force)
TUTORIAL_PRE_decomposition_ok=(check_collated_decomposition)

TUTORIAL_RUN_STEPS=(system constant initial decomposition solve final_time execution_time residual)
TUTORIAL_RUN_system=(require_directory system)
TUTORIAL_RUN_constant=(require_directory constant)
TUTORIAL_RUN_initial=(require_directory 0)
TUTORIAL_RUN_decomposition=(check_collated_decomposition)
TUTORIAL_RUN_solve=(run_parallel solver pimpleFoam -parallel)
TUTORIAL_RUN_final_time=(require_final_time solver 100)
TUTORIAL_RUN_execution_time=(warn_execution_time solver 50)
TUTORIAL_RUN_residual=(require_final_initial_residual solver Ux 0.012)
